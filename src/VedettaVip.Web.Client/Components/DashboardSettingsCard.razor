@using VedettaVip.Shared.Contracts

<section class="settings-card card">
    <div class="card-header"><strong>Dashboard</strong></div>
    <div class="card-body">
        @if (error is not null)
        {
            <div class="alert alert-danger py-1 px-2 small">@error</div>
        }
        @if (loaded)
        {
            <div class="threshold-grid">
                <label for="d-hours">Eventi recenti mostrati nella Home (ore)</label>
                <input id="d-hours" class="form-control form-control-sm" type="number" min="1" max="@DashboardSettingsDto.MaxEventHours"
                       @bind="hours" />
                <span class="small text-muted">1–@DashboardSettingsDto.MaxEventHours</span>
            </div>
            <div class="form-text">Periodo predefinito per tutti gli utenti; dalla Home si può scegliere un altro periodo al volo.</div>
            <div class="d-flex align-items-baseline gap-2 mt-3">
                <button class="btn btn-sm btn-primary" disabled="@busy" @onclick="SaveAsync">Salva</button>
                @if (savedAt is { } at)
                {
                    <span class="small text-success">Salvato alle @at.ToString("HH:mm:ss").</span>
                }
            </div>
        }
    </div>
</section>
