@using VedettaVip.Shared.Contracts

<section class="settings-card card">
    <div class="card-header"><strong>Profili RouterOS (API)</strong></div>
    <div class="card-body">
        <p class="small text-muted">
            Accesso all'API dei MikroTik per leggere CPU, memoria, temperatura, tensione, uptime e versione. Sul router serve
            un utente <b>read-only</b> dedicato e il servizio <code>api</code> (in chiaro) o <code>api-ssl</code> (TLS, con un
            certificato assegnato al servizio: va bene autofirmato, lasciando spenta la verifica). Profilo usato: quello del
            dispositivo, poi quello del cliente (<a href="settings/customers">Clienti</a>), poi il predefinito. La password è
            cifrata e non viene mai rimostrata.
        </p>
        <details class="small mb-2">
            <summary>Comandi per creare l'utente sul router</summary>
            <pre class="ros-commands">/user group add name=vedettavip-read policy=read,api,!write,!policy,!sensitive,!test,!password,!sniff,!romon
/user add name=vedettavip group=vedettavip-read password="..." address=IP_DEL_SERVER_VEDETTAVIP
/ip service set api address=IP_DEL_SERVER_VEDETTAVIP           # in chiaro, porta 8728
/ip service set api-ssl address=IP_DEL_SERVER_VEDETTAVIP certificate=...   # TLS, porta 8729</pre>
        </details>
        @if (error is not null)
        {
            <div class="alert alert-danger py-1 px-2 small">@error</div>
        }

        @if (profiles is not null)
        {
            @if (profiles.Count > 0)
            {
                <table class="table table-sm align-middle ros-table">
                    <thead><tr><th>Predefinito</th><th>Nome</th><th>Utente</th><th>Servizio</th><th>Uso</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var p in profiles)
                        {
                            <tr @key="p.Id" class="@(p.Id == editingId ? "table-active" : "")">
                                <td>
                                    <input class="form-check-input" type="radio" name="ros-default" checked="@p.IsDefault"
                                           title="Usa come profilo predefinito" disabled="@busy" @onchange="() => SetDefaultAsync(p.Id)" />
                                </td>
                                <td>@p.Name<div class="small text-muted">@p.Description</div></td>
                                <td class="font-monospace small">@p.Username</td>
                                <td class="small">@ServiceText(p)</td>
                                <td class="small">@UsageText(p)</td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(p)">Modifica</button>
                                    <DeleteButton Busy="busy" OnConfirmed="() => DeleteAsync(p)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (profiles.Any(p => p.IsDefault))
                {
                    <button class="btn btn-sm btn-link p-0 mb-2" disabled="@busy" @onclick="() => SetDefaultAsync(null)">
                        Nessun predefinito (si leggono solo i dispositivi con un profilo proprio o del cliente)
                    </button>
                }
            }

            <h6 class="mt-2">@(editingId is null ? "Nuovo profilo" : "Modifica profilo")</h6>
            <div class="ros-form">
                <label>Nome <input class="form-control form-control-sm" maxlength="128" placeholder="es. Cliente Rossi" @bind="name" @bind:event="oninput" /></label>
                <label>Descrizione <input class="form-control form-control-sm" maxlength="512" placeholder="facoltativa" @bind="description" /></label>
                <label>Utente <input class="form-control form-control-sm font-monospace" maxlength="64" placeholder="vedettavip" @bind="username" @bind:event="oninput" /></label>
                <label>Password
                    <input class="form-control form-control-sm" type="password" autocomplete="new-password" maxlength="256"
                           placeholder="@(editingId is null ? "" : "vuota = invariata")" @bind="password" @bind:event="oninput" />
                </label>
                <label>Servizio
                    <select class="form-select form-select-sm" @bind="service" @bind:after="OnServiceChanged">
                        <option value="@ApiService">api (in chiaro)</option>
                        <option value="@ApiSslService">api-ssl (TLS)</option>
                    </select>
                </label>
                <label>Porta <input class="form-control form-control-sm" type="number" min="1" max="65535" @bind="port" /></label>
                @if (useTls)
                {
                    <div class="form-check align-self-end">
                        <input id="ros-verify" class="form-check-input" type="checkbox" @bind="verifyCertificate" />
                        <label class="form-check-label small" for="ros-verify">Verifica il certificato (CA attendibile e nome corrispondente)</label>
                    </div>
                }
            </div>
            <div class="d-flex gap-2 mt-2">
                <button class="btn btn-sm btn-primary" disabled="@(!CanSave())" @onclick="SaveAsync">@(editingId is null ? "Aggiungi" : "Salva")</button>
                @if (editingId is not null)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ResetForm">Annulla</button>
                }
            </div>
            @if (!useTls)
            {
                <div class="form-text">Con <code>api</code> utente e password viaggiano in chiaro: usarlo solo in LAN o dentro una VPN.</div>
            }
        }
    </div>
</section>
