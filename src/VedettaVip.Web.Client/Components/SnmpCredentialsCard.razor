@using VedettaVip.Shared.Contracts

<section class="settings-card card">
    <div class="card-header"><strong>Profili SNMP (v1/v2c)</strong></div>
    <div class="card-body">
        <p class="small text-muted">
            Community condivise, cifrate nel database e mai rimostrate. Ogni dispositivo usa il proprio profilo, altrimenti
            quello del suo cliente (<a href="settings/customers">Clienti</a>), altrimenti il predefinito; senza nessuno dei tre, la community della
            configurazione del Worker. Le modifiche arrivano subito agli agenti.
        </p>
        @if (error is not null)
        {
            <div class="alert alert-danger py-1 px-2 small">@error</div>
        }

        @if (profiles is not null)
        {
            @if (profiles.Count > 0)
            {
                <table class="table table-sm align-middle snmp-table">
                    <thead><tr><th>Predefinito</th><th>Nome</th><th>Descrizione</th><th>Uso</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var p in profiles)
                        {
                            <tr @key="p.Id" class="@(p.Id == editingId ? "table-active" : "")">
                                <td>
                                    <input class="form-check-input" type="radio" name="snmp-default" checked="@p.IsDefault"
                                           title="Usa come profilo predefinito" disabled="@busy" @onchange="() => SetDefaultAsync(p.Id)" />
                                </td>
                                <td>@p.Name</td>
                                <td class="small text-muted">@p.Description</td>
                                <td class="small">@UsageText(p)</td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(p)">Modifica</button>
                                    <DeleteButton Busy="busy" OnConfirmed="() => DeleteAsync(p)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (profiles.Any(p => p.IsDefault))
                {
                    <button class="btn btn-sm btn-link p-0 mb-2" disabled="@busy" @onclick="() => SetDefaultAsync(null)">
                        Nessun predefinito (usa la community del Worker)
                    </button>
                }
            }

            <h6 class="mt-2">@(editingId is null ? "Nuovo profilo" : "Modifica profilo")</h6>
            <div class="snmp-form">
                <input class="form-control form-control-sm" placeholder="Nome (es. Cliente Rossi)" maxlength="128" @bind="name" @bind:event="oninput" />
                <input class="form-control form-control-sm" placeholder="Descrizione (facoltativa)" maxlength="512" @bind="description" />
                <input class="form-control form-control-sm" type="password" autocomplete="new-password" maxlength="255"
                       placeholder="@(editingId is null ? "Community" : "Community: vuota = invariata")" @bind="community" @bind:event="oninput" />
                <button class="btn btn-sm btn-primary text-nowrap" disabled="@(!CanSave())" @onclick="SaveAsync">
                    @(editingId is null ? "Aggiungi" : "Salva")
                </button>
                @if (editingId is not null)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ResetForm">Annulla</button>
                }
            </div>
        }
    </div>
</section>
