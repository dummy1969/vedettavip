@using VedettaVip.Shared.Contracts
@using VedettaVip.Shared.Models

<aside class="background-panel">
    <h6>Sfondo della mappa</h6>

    @if (error is not null)
    {
        <div class="alert alert-danger py-1 px-2 small">@error</div>
    }

    <label class="form-label small mb-1" for="bg-mode">Tipo</label>
    <select id="bg-mode" class="form-select form-select-sm" @bind="mode" @bind:after="Preview">
        <option value="@nameof(MapBackgroundMode.None)">Nessuno (griglia)</option>
        <option value="@nameof(MapBackgroundMode.Image)">Immagine (planimetria, cartina)</option>
        <option value="@nameof(MapBackgroundMode.Geo)">Mappa geografica (OpenStreetMap)</option>
    </select>

    @if (Mode == MapBackgroundMode.Image)
    {
        <div class="mt-2 small">
            @if (image is { } img)
            {
                <span>Immagine caricata: @img.Width × @img.Height px.</span>
            }
            else
            {
                <span class="text-muted">Nessuna immagine caricata.</span>
            }
        </div>
        <label class="form-label small mb-1 mt-2" for="bg-file">@(image is null ? "Carica" : "Sostituisci") (PNG, JPEG o WebP, max 5 MB)</label>
        <InputFile id="bg-file" class="form-control form-control-sm" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp"
                   OnChange="UploadAsync" disabled="@busy" />
        @if (image is not null)
        {
            <div class="panel-actions">
                <DeleteButton Text="Rimuovi immagine" ConfirmText="Conferma: rimuovi l'immagine" Busy="busy" OnConfirmed="DeleteImageAsync" />
            </div>
        }

        <label class="form-label small mb-1 mt-2" for="bg-scale">Scala (%)</label>
        <input id="bg-scale" class="form-control form-control-sm" type="number" min="1" max="1000" step="5"
               @bind="scalePct" @bind:after="Preview" />
        <div class="form-text">L'immagine parte dall'angolo in alto a sinistra della mappa; 100 = un pixel dell'immagine per unità
            della mappa (i nodi sono larghi circa 100).</div>
    }
    else if (Mode == MapBackgroundMode.Geo)
    {
        <label class="form-label small mb-1 mt-2" for="bg-center">Centro (latitudine, longitudine)</label>
        <input id="bg-center" class="form-control form-control-sm font-monospace" placeholder="44.494, 11.342"
               @bind="centerText" @bind:event="oninput" @bind:after="Preview" />
        <div class="form-text">
            @if (centerText.Trim().Length > 0 && !GeoTiles.TryParseLatLon(centerText, out _, out _))
            {
                <span class="text-danger">Coordinate non valide: due numeri col punto decimale, es. 44.494, 11.342.</span>
            }
            else
            {
                <span>Da Google Maps: clic destro sul punto e clic sulle coordinate per copiarle. Il centro dei nodi della mappa
                    finisce qui; poi i nodi si trascinano sulle località.</span>
            }
        </div>

        <label class="form-label small mb-1 mt-2" for="bg-zoom">Dettaglio</label>
        <select id="bg-zoom" class="form-select form-select-sm" @bind="geoZoom" @bind:after="Preview">
            @foreach (var (z, label) in GeoTiles.ZoomPresets)
            {
                <option value="@z">@label (livello @z)</option>
            }
            @if (GeoTiles.ZoomPresets.All(p => p.Zoom != geoZoom))
            {
                <option value="@geoZoom">livello @geoZoom</option>
            }
        </select>
        <div class="form-text">A zoom 100% della vista. Con la rotella ci si allontana fino a vedere l'intera area.</div>
    }

    @if (Mode != MapBackgroundMode.None)
    {
        <label class="form-label small mb-1 mt-2" for="bg-opacity">Opacità: @opacityPct %</label>
        <input id="bg-opacity" class="form-range" type="range" min="10" max="100" step="5"
               @bind="opacityPct" @bind:event="oninput" @bind:after="Preview" />

        <div class="form-check">
            <input id="bg-grid" class="form-check-input" type="checkbox" @bind="showGrid" @bind:after="Preview" />
            <label class="form-check-label small" for="bg-grid">Mostra la griglia sopra lo sfondo</label>
        </div>
    }

    <div class="panel-actions">
        <button class="btn btn-sm btn-primary" disabled="@(busy || !CanSave())" @onclick="SaveAsync">Salva</button>
        <button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="CloseAsync">Chiudi</button>
    </div>
    <div class="form-text">Le modifiche si vedono subito sulla mappa; "Chiudi" senza salvare le annulla.
        @if (Mode == MapBackgroundMode.Geo)
        {
            <span>Serve internet nel browser; i tasselli di OpenStreetMap sono per un uso leggero (Impostazioni → Mappe per un altro fornitore).</span>
        }
    </div>
</aside>
