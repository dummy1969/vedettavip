<div class="user-menu">
    @if (me is { Authenticated: true })
    {
        <a href="account" title="@CurrentUser.RoleName(me.Role)">@me.DisplayName</a>
        <span class="role">@CurrentUser.RoleName(me.Role)</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="LogoutAsync">Esci</button>
    }
    else if (me is not null)
    {
        <a href="login">Accedi</a>
    }
</div>
