@page "/login"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using VedettaVip.Shared.Contracts

<PageTitle>Accedi - VedettaVip</PageTitle>

<div class="login-card card">
    <div class="card-body">
        @if (me is null && error is null)
        {
            <p><em>Caricamento...</em></p>
        }
        else if (me?.SetupRequired == true)
        {
            <h4>Crea il primo amministratore</h4>
            <p class="small text-muted">
                Nessun utente configurato. Il <b>codice di setup</b> è nel log dell'API, nella riga
                "Codice di setup" (cambia a ogni riavvio dell'API).
            </p>
            <form @onsubmit="SetupAsync" @onsubmit:preventDefault>
                <label class="form-label small mb-1" for="s-code">Codice di setup</label>
                <input id="s-code" class="form-control font-monospace" @bind="setupCode" placeholder="XXXX-XXXX-XXXX" autocomplete="off" />
                <label class="form-label small mb-1 mt-2" for="s-user">Nome utente</label>
                <input id="s-user" class="form-control" @bind="userName" autocomplete="username" />
                <label class="form-label small mb-1 mt-2" for="s-name">Nome visualizzato</label>
                <input id="s-name" class="form-control" @bind="displayName" placeholder="es. Mario Rossi" />
                <label class="form-label small mb-1 mt-2" for="s-pass">Password (almeno 10 caratteri)</label>
                <input id="s-pass" class="form-control" type="password" @bind="password" autocomplete="new-password" />
                <label class="form-label small mb-1 mt-2" for="s-pass2">Ripeti la password</label>
                <input id="s-pass2" class="form-control" type="password" @bind="password2" autocomplete="new-password" />
                <button class="btn btn-primary w-100 mt-3" type="submit" disabled="@busy">Crea e accedi</button>
            </form>
        }
        else if (twoFactor)
        {
            <h4>Verifica in due passaggi</h4>
            @if (!useRecoveryCode)
            {
                <p class="small text-muted">Inserisci il codice a 6 cifre mostrato dall'app di autenticazione per <b>@userName</b>.</p>
                <form @onsubmit="TwoFactorAsync" @onsubmit:preventDefault>
                    <label class="form-label small mb-1" for="t-code">Codice</label>
                    <input id="t-code" class="form-control font-monospace code-input" @bind="code" inputmode="numeric"
                           autocomplete="one-time-code" maxlength="9" placeholder="123456" autofocus />
                    <div class="form-check mt-2">
                        <input id="t-remember" class="form-check-input" type="checkbox" @bind="rememberBrowser" />
                        <label class="form-check-label small" for="t-remember">
                            Non chiedere il codice su questo browser per @TwoFactorDefaults.RememberBrowserDays giorni
                        </label>
                    </div>
                    <button class="btn btn-primary w-100 mt-3" type="submit" disabled="@busy">Verifica</button>
                </form>
                <button class="btn btn-link btn-sm px-0 mt-2" @onclick="() => SwitchCode(true)">Telefono non disponibile? Usa un codice di recupero</button>
            }
            else
            {
                <p class="small text-muted">
                    Inserisci uno dei codici di recupero salvati all'attivazione (formato XXXXX-XXXXX). Ogni codice vale una volta sola.
                </p>
                <form @onsubmit="RecoveryCodeAsync" @onsubmit:preventDefault>
                    <label class="form-label small mb-1" for="t-recovery">Codice di recupero</label>
                    <input id="t-recovery" class="form-control font-monospace" @bind="recoveryCode" autocomplete="off" autofocus />
                    <button class="btn btn-primary w-100 mt-3" type="submit" disabled="@busy">Accedi</button>
                </form>
                <button class="btn btn-link btn-sm px-0 mt-2" @onclick="() => SwitchCode(false)">Usa il codice dell'app</button>
            }
            <button class="btn btn-link btn-sm px-0 d-block" @onclick="Restart">Torna all'inserimento della password</button>
        }
        else
        {
            <h4>Accedi a VedettaVip</h4>
            <form @onsubmit="LoginAsync" @onsubmit:preventDefault>
                <label class="form-label small mb-1" for="l-user">Nome utente</label>
                <input id="l-user" class="form-control" @bind="userName" autocomplete="username" />
                <label class="form-label small mb-1 mt-2" for="l-pass">Password</label>
                <input id="l-pass" class="form-control" type="password" @bind="password" autocomplete="current-password" />
                <div class="form-check mt-2">
                    <input id="l-remember" class="form-check-input" type="checkbox" @bind="rememberMe" />
                    <label class="form-check-label small" for="l-remember">Ricordami su questo computer</label>
                </div>
                <button class="btn btn-primary w-100 mt-3" type="submit" disabled="@busy">Accedi</button>
            </form>
        }

        @if (error is not null)
        {
            <div class="alert alert-danger py-1 px-2 small mt-3 mb-0">@error</div>
        }
    </div>
</div>
