@page "/account"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using VedettaVip.Shared.Contracts

<PageTitle>Account - VedettaVip</PageTitle>

<h3>Il mio account</h3>

@if (User.Value is { Authenticated: true } me)
{
    <p>
        <b>@me.DisplayName</b> (@me.UserName) · @CurrentUser.RoleName(me.Role)
    </p>

    <section class="card account-card">
        <div class="card-header"><strong>Cambia password</strong></div>
        <div class="card-body">
            <form @onsubmit="ChangePasswordAsync" @onsubmit:preventDefault>
                <label class="form-label small mb-1" for="a-cur">Password attuale</label>
                <input id="a-cur" class="form-control form-control-sm" type="password" @bind="current" autocomplete="current-password" />
                <label class="form-label small mb-1 mt-2" for="a-new">Nuova password (almeno 10 caratteri)</label>
                <input id="a-new" class="form-control form-control-sm" type="password" @bind="newPassword" autocomplete="new-password" />
                <label class="form-label small mb-1 mt-2" for="a-new2">Ripeti la nuova password</label>
                <input id="a-new2" class="form-control form-control-sm" type="password" @bind="newPassword2" autocomplete="new-password" />
                <button class="btn btn-sm btn-primary mt-3" type="submit" disabled="@busy">Cambia password</button>
            </form>
            @if (message is not null)
            {
                <div class="small mt-2 @(isError ? "text-danger" : "text-success")">@message</div>
            }
        </div>
    </section>

    <section class="card account-card mt-3">
        <div class="card-header d-flex align-items-center gap-2">
            <strong>Verifica in due passaggi</strong>
            @if (twoFactor?.Enabled == true)
            {
                <span class="badge text-bg-success">attiva</span>
            }
        </div>
        <div class="card-body small">
            @if (recoveryCodes is not null)
            {
                <p>
                    <b>Codici di recupero.</b> Salvali adesso (gestore di password o foglio in un posto sicuro): non verranno più
                    mostrati. Ognuno permette un accesso senza telefono, una volta sola.
                </p>
                <ul class="recovery-codes font-monospace">
                    @foreach (var c in recoveryCodes)
                    {
                        <li>@c</li>
                    }
                </ul>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CopyCodesAsync">@(copied ? "Copiati" : "Copia")</button>
                    <a class="btn btn-sm btn-outline-secondary" href="@CodesDownloadHref" download="vedettavip-codici-recupero.txt">Scarica .txt</a>
                    <button class="btn btn-sm btn-primary" @onclick="CodesSaved">Li ho salvati</button>
                </div>
            }
            else if (twoFactor is null)
            {
                <p class="mb-0"><em>Caricamento...</em></p>
            }
            else if (setup is not null)
            {
                <p>
                    1. Inquadra il QR code con l'app di autenticazione (Google o Microsoft Authenticator, Aegis, 2FAS, Bitwarden…),
                    oppure inserisci la chiave a mano.
                </p>
                <img class="qr-code" src="@setup.QrCodeDataUri" alt="QR code per l'app di autenticazione" />
                <div class="mt-2">Chiave: <code class="user-select-all">@setup.SharedKey</code></div>
                <p class="mt-3 mb-1">2. Inserisci il codice a 6 cifre che l'app mostra adesso.</p>
                <form class="d-flex gap-2" @onsubmit="EnableAsync" @onsubmit:preventDefault>
                    <input class="form-control form-control-sm font-monospace code-input" @bind="code" inputmode="numeric"
                           autocomplete="one-time-code" maxlength="9" placeholder="123456" aria-label="Codice dell'app" />
                    <button class="btn btn-sm btn-primary text-nowrap" type="submit" disabled="@busy">Attiva</button>
                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="CancelSetup">Annulla</button>
                </form>
            }
            else if (!twoFactor.Enabled)
            {
                <p>
                    Oltre alla password, all'accesso viene chiesto il codice a 6 cifre di un'app di autenticazione sul telefono
                    (standard TOTP: Google o Microsoft Authenticator, Aegis, 2FAS, Bitwarden…).
                </p>
                <button class="btn btn-sm btn-primary" disabled="@busy" @onclick="StartSetupAsync">Configura</button>
            }
            else
            {
                <p class="@(twoFactor.RecoveryCodesLeft <= 3 ? "text-danger" : "")">
                    Codici di recupero rimasti: <b>@twoFactor.RecoveryCodesLeft</b> di @TwoFactorDefaults.RecoveryCodeCount
                    @if (twoFactor.RecoveryCodesLeft <= 3) {<span>: generane di nuovi.</span>}
                </p>
                @if (twoFactor.BrowserRemembered)
                {
                    <p>
                        Questo browser è ricordato: il codice non viene chiesto fino alla scadenza.
                        <button class="btn btn-link btn-sm p-0 align-baseline" disabled="@busy" @onclick="ForgetBrowserAsync">Dimentica questo browser</button>
                    </p>
                }

                <label class="form-label mb-1" for="a-regen">Nuovi codici di recupero (i vecchi non varranno più)</label>
                <form class="d-flex gap-2" @onsubmit="RegenerateAsync" @onsubmit:preventDefault>
                    <input id="a-regen" class="form-control form-control-sm font-monospace" @bind="code" inputmode="numeric"
                           autocomplete="one-time-code" maxlength="9" placeholder="codice dell'app" />
                    <button class="btn btn-sm btn-outline-primary text-nowrap" type="submit" disabled="@busy">Genera</button>
                </form>

                <label class="form-label mb-1 mt-3" for="a-disable">Disattiva (richiede la password)</label>
                <form class="d-flex gap-2" @onsubmit="DisableAsync" @onsubmit:preventDefault>
                    <input id="a-disable" class="form-control form-control-sm" type="password" @bind="disablePassword" autocomplete="current-password" />
                    <button class="btn btn-sm btn-outline-danger text-nowrap" type="submit" disabled="@busy">Disattiva</button>
                </form>
            }
            @if (tfaMessage is not null)
            {
                <div class="mt-2 @(tfaIsError ? "text-danger" : "text-success")">@tfaMessage</div>
            }
        </div>
    </section>
}
else
{
    <p><em>Caricamento...</em></p>
}
