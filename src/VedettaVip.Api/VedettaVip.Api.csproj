<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>bf2fec2e-e3ba-4d07-8f4d-928bef79ab1e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- MimeKit (MailKit) chiede la 10.0.0, vulnerabile (CVE-2026-84008, CVE-2026-70162): fissata alla versione corretta -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VedettaVip.Shared\VedettaVip.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Produttori dai MAC (registri IEEE): generato da third-party/ieee-oui/generate.py -->
    <EmbeddedResource Include="Resources\oui.tsv.gz" LogicalName="VedettaVip.Api.oui.tsv.gz" />
    <!-- Installer del gestore dei link (LinkHandlerScripts): i percorsi di WinBox e PuTTY sono scritti al download -->
    <EmbeddedResource Include="Resources\LinkHandler\*" LogicalName="VedettaVip.Api.LinkHandler.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings.Local.json: configurazione dell'installazione, fuori da Git -->
    <Compile Include="..\LocalSettings.cs" Link="LocalSettings.cs" />
  </ItemGroup>
</Project>
