{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Polling": {
    "IntervalSeconds": 30,
    "IcmpTimeoutMs": 1500,
    "SnmpTimeoutMs": 3000,
    "MaxDegreeOfParallelism": 32,
    "DownAfterFailures": 3,
    "UpAfterSuccesses": 2,
    "SnmpDegradedAfterFailures": 2,
    "InterfaceInventoryMinutes": 15,
    "SnmpCommunity": "public"
  },
  "Agent": {
    "ApiBaseUrl": "http://localhost:5197",
    "TargetsRefreshSeconds": 120,
    "SnapshotIntervalSeconds": 300,
    "BufferCapacity": 10000
  }
}
