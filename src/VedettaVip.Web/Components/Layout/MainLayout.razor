@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <VedettaVip.Web.Client.Components.UserMenu @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
        </div>

        <article class="content px-4">
            @Body
        </article>

        @* Attribuzione richiesta dal NOTICE (AGPL-3.0, sezione 7(b)): va conservata nelle versioni modificate *@
        <footer class="app-footer px-4">
            <a href="about">VedettaVip</a> – © 2026 Marcello Anderlini –
            <a href="https://www.gnu.org/licenses/agpl-3.0.html" target="_blank" rel="noopener">AGPL-3.0</a> –
            <a href="@SourceUrl" target="_blank" rel="noopener">Source code</a>
        </footer>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
