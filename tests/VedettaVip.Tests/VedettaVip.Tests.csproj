<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VedettaVip.Shared\VedettaVip.Shared.csproj" />
    <ProjectReference Include="..\..\src\VedettaVip.Worker\VedettaVip.Worker.csproj" />
    <ProjectReference Include="..\..\src\VedettaVip.Api\VedettaVip.Api.csproj" />
  </ItemGroup>

  <!-- Catalogo icone del client: solo i sorgenti (dipendono da VedettaVip.Shared). Un ProjectReference al client
       WebAssembly lo ricompilerebbe con fingerprint diversi da quelli del manifest di VedettaVip.Web (vedi CLAUDE.md). -->
  <ItemGroup>
    <Compile Include="..\..\src\VedettaVip.Web.Client\Services\MapIcons.cs" Link="Linked\MapIcons.cs" />
    <Compile Include="..\..\src\VedettaVip.Web.Client\Services\MapIcons.g.cs" Link="Linked\MapIcons.g.cs" />
    <Compile Include="..\..\src\VedettaVip.Web.Client\Services\UiIcons.cs" Link="Linked\UiIcons.cs" />
    <Compile Include="..\..\src\VedettaVip.Web.Client\Services\UiIcons.g.cs" Link="Linked\UiIcons.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\LocalSettings.cs" Link="Linked\LocalSettings.cs" />
  </ItemGroup>
</Project>