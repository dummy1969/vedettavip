# Configurazione dello stack completo (deploy/docker-compose.yml). Copiare e compilare (il .env NON va committato):
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# deploy/production/deploy.sh, al primo deploy senza --config, genera da questo modello un .env sul server con
# password e chiave casuali. I valori qui sotto funzionano per una prova, ma vanno CAMBIATI prima dell'uso reale.

# Indirizzo con cui si apre VedettaVip (IP o nome DNS): usato da Caddy per il certificato HTTPS.
# Per una prova sullo stesso PC: VEDETTAVIP_HOST=localhost
VEDETTAVIP_HOST=192.0.2.10

# Porte pubblicate da Caddy (default 80 e 443)
HTTP_PORT=80
HTTPS_PORT=443

# Utente e database "netmap": nomi storici (il progetto si chiamava NetMap). Valgono solo alla creazione del volume:
# cambiare la password dopo il primo avvio richiede ALTER USER nel database.
POSTGRES_USER=netmap
POSTGRES_DB=netmap
POSTGRES_PASSWORD=cambiami-password-del-database

# Chiave condivisa API/agenti (almeno 32 caratteri), es.: openssl rand -base64 36
AGENT_API_KEY=cambiami-chiave-agenti-di-almeno-32-caratteri
# Nome dell'agente di polling sul server
AGENT_ID=vedettavip-server

# Ripiego se nessun profilo SNMP è configurato (Impostazioni → Profili SNMP)
SNMP_COMMUNITY=public

TZ=Europe/Rome

# Link "Source code" dell'interfaccia: chi offre una versione modificata deve indicare il proprio sorgente
# (AGPL-3.0, sezione 13). Vuoto = repository ufficiale.
APP_SOURCE_URL=

# Solo per deploy/production/deploy.sh (ignorate da Docker Compose): host SSH del server
VEDETTAVIP_SSH_HOST=

# Backup notturno sul server (backup.sh, timer systemd vedettavip-backup.timer alle 02:30)
BACKUP_DIR=/var/backups/vedettavip
BACKUP_KEEP_DAYS=14
# Copia esterna: cartella su un NAS/disco già montato (es. /mnt/vedettavip-nas/vedettavip); vuoto = nessuna copia
BACKUP_COPY_DIR=
