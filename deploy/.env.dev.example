# Database di sviluppo (dev.sh, deploy/docker-compose.dev.yml). Copiare e personalizzare (deploy/.env.dev NON va committato):
#   cp deploy/.env.dev.example deploy/.env.dev

# Utente e database "netmap": nomi storici (il progetto si chiamava NetMap). Valgono solo alla creazione del volume.
POSTGRES_USER=netmap
POSTGRES_PASSWORD=cambiami-con-una-password-robusta
POSTGRES_DB=netmap

# Porta esposta su 127.0.0.1 (default 5432)
POSTGRES_PORT=5432

TZ=Europe/Rome
